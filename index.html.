    <style>
        :root {
            --bg-color: #0f172a;
            --card-bg: #1e293b;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --primary: #3b82f6;
            --hover-color: #2563eb;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            margin: 0;
            padding: 40px 20px;
            display: flex;
            justify-content: center;
            line-height: 1.6;
        }

        .container {
            max-width: 650px;
            width: 100%;
            text-align: center;
        }

        .profile-img {
            width: 160px;
            height: 160px;
            border-radius: 50%;
            margin-bottom: 24px;
            border: 4px solid var(--primary);
            object-fit: cover;
            box-shadow: 0 0 20px rgba(59, 130, 246, 0.3);
        }

        h1 { 
            margin: 0 0 8px 0; 
            font-size: 2.2rem; 
            letter-spacing: -0.5px;
        }

        .bio { 
            color: var(--text-muted); 
            margin-bottom: 35px; 
            font-size: 1.05rem;
        }

        .highlight {
            color: var(--primary);
            font-weight: 600;
        }

        .links-grid {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .link-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: var(--card-bg);
            color: var(--text-main);
            text-decoration: none;
            padding: 16px 20px;
            border-radius: 12px;
            font-weight: 500;
            transition: all 0.3s ease;
            border: 1px solid #334155;
            font-size: 1.1rem;
        }

        .link-btn:hover {
            background-color: var(--hover-color);
            border-color: var(--primary);
            transform: translateY(-3px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.3);
        }

        .icon {
            margin-right: 10px;
            font-size: 1.3rem;
        }

        .footer {
            margin-top: 50px;
            font-size: 0.9rem;
            color: var(--text-muted);
        }
    </style>
</head>
